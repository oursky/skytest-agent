{
  "name": "@skytest/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "npm run db:generate && eslint && npx tsc --noEmit --incremental false",
    "auth:check-routes": "node scripts/security/check-auth-route-coverage.mjs",
    "protocol:check-boundary": "node scripts/security/check-runner-protocol-boundary.mjs",
    "quality:check-hotspots": "node scripts/quality/check-hotspot-loc.mjs",
    "quality:check-config-i18n": "node scripts/quality/check-config-i18n-guardrails.mjs",
    "quality:check-runner-contracts": "node scripts/quality/check-runner-contract-centralization.mjs",
    "audit": "node scripts/security/audit-ci.mjs",
    "verify": "npm run lint && npm run auth:check-routes && npm run protocol:check-boundary && npm run quality:check-hotspots && npm run quality:check-config-i18n && npm run quality:check-runner-contracts && npm run audit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:migrate:test": "bash scripts/db/verify-migrations.sh",
    "db:studio": "prisma studio",
    "playwright:install": "playwright install chromium",
    "test": "vitest --run",
    "runner:maintenance": "tsx src/workers/runner-maintenance.ts",
    "browser:worker": "tsx src/workers/browser-runner.ts",
    "perf:seed:runner-claim": "tsx scripts/load-gate/seed-runner-claim.ts",
    "perf:gate:browser-runs": "tsx scripts/load-gate/gate-browser-runs.ts",
    "perf:gate:runner-events": "k6 run scripts/load-gate/runner-events.k6.js",
    "load-gate:sse": "tsx scripts/load-gate/gate-sse-events.ts",
    "load-gate:sse:smoke": "LOAD_GATE_SSE_PROFILE=smoke npm run load-gate:sse",
    "load-gate:sse:standard": "LOAD_GATE_SSE_PROFILE=standard npm run load-gate:sse",
    "load-gate:sse:stress": "LOAD_GATE_SSE_PROFILE=stress npm run load-gate:sse",
    "smoke:storage": "tsx scripts/smoke/storage-s3.ts"
  },
  "dependencies": {
    "@authgear/web": "5.0.1",
    "@aws-sdk/client-s3": "3.1013.0",
    "@aws-sdk/s3-request-presigner": "3.1013.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@langfuse/openai": "4.6.1",
    "@midscene/android": "1.5.1",
    "@midscene/web": "1.5.1",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@monaco-editor/react": "4.7.0",
    "@playwright/test": "1.57.0",
    "@prisma/client": "6.12.0",
    "@skytest/runner-protocol": "0.1.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/archiver": "7.0.0",
    "archiver": "7.0.1",
    "exceljs": "4.4.0",
    "jose": "6.1.3",
    "langsmith": "0.5.8",
    "next": "16.1.7",
    "pg": "8.20.0",
    "playwright": "1.57.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.5",
    "postcss": "8.5.6",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "overrides": {
    "vite": "7.3.2",
    "fast-xml-parser": "5.5.7",
    "flatted": "3.4.2"
  }
}
